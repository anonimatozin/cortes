# divulgacao/.env  — opcional.
# O projeto já lê o .env da RAIZ (GROQ_API_KEY etc.). Este arquivo só acrescenta
# configuração específica da divulgação e sobrescreve o da raiz quando existe.

# Mestre da integração automática com cortes.py (on/off). Padrão: off.
DIVULGACAO_ATIVO=off

# Nicho usado nas buscas do YouTube e nas sugestões de grupos.
DIVULGACAO_NICHO=podcast

# Chave da YouTube Data API v3 (Google Cloud Console -> APIs e Services ->
# Credentials -> Create credentials -> API key). Sem ela o módulo usa o OAuth
# já existente do projeto (tokens/youtube.json) ou segue sem dados reais.
YOUTUBE_API_KEY=

# Liga/desliga módulos individualmente (necessário só se quiser por fora do config.yaml)
#DIVULGACAO_MODULO_HASHTAGS=true
#DIVULGACAO_MODULO_GRUPOS=true
#DIVULGACAO_MODULO_REGISTRO=true

# IA: auto | on | off  (auto = usa só se houver GROQ_API_KEY)
#DIVULGACAO_IA=auto

# Google Trends via pytrends (não oficial, pode quebrar; requer pip install pytrends)
#DIVULGACAO_TRENDS=off

# Limites
#DIVULGACAO_GRUPOS_MAX_POR_DIA=2
#DIVULGACAO_GRUPOS_DIAS_ENTRE=7
#DIVULGACAO_GRUPOS_DIAS_PLANO=14
#DIVULGACAO_YT_COTA_DIA=9000

# Modo de teste (sai em pasta temporária, não toca nos arquivos reais)
#DIVULGACAO_MODO_TESTE=0
